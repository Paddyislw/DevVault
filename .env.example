BOT_TOKEN=your_telegram_bot_token_here
DATABASE_URL=postgresql://user:pass@localhost:5432/devvault
GEMINI_API_KEY=your_gemini_key_here

# Bot — HTTPS URL of the deployed web app, used for the Mini App menu button.
# Must be a real HTTPS domain; Telegram won't accept localhost.
WEB_APP_URL=https://your-domain.example.com

# Web app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
NEXT_PUBLIC_BOT_USERNAME=devvault_dev_bot

# Redis (Railway)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Dev-only login bypass — skips the Telegram Login Widget so the dashboard
# works on plain localhost. Only active when NODE_ENV=development.
# NEVER set DEV_LOGIN in a deployed environment.
DEV_LOGIN=true
DEV_TELEGRAM_ID=your_telegram_user_id
